# ~/.config/i3blocks/config

# General settings
separator_block_width=10
markup=pango

# Block definitions

[cpu]
label=󰻠
command=top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1"%"}'
interval=2

[aiov2]
command=~/.config/i3blocks/aiov2.sh
interval=5

[memory]
label=
command=free -h | awk '/^Mem:/ {print $3 "/" $2}'
interval=5

[temperature]
label=󰔄
command=~/.config/i3/scripts/rpitemp.sh
interval=10

#[volume]
#label=󰓃
#command=amixer get PCM | awk -F'[][]' 'END{print $4}'
#interval=1

[wifi]
command=~/.config/i3blocks/wifi.sh
interval=10

[network]
label=󰩠
command=ip a | grep 'state UP' -A2 | tail -n1 | awk '{print $2}' | cut -d'/' -f1
interval=5

[battery]
#label=
#command=echo "$(cat /sys/class/power_supply/axp20x-battery/capacity)%"
command=~/.config/i3blocks/battery.sh
interval=30

[time]
label=󰥔
command=date '+%d-%m-%Y %H:%M:%S'
interval=1
